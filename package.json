{
  "name": "termdock",
  "displayName": "Termdock",
  "description": "A compact, independent shell terminal with native controls in the Secondary Side Bar.",
  "version": "0.3.0",
  "publisher": "yevin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "pty",
    "remote",
    "xterm",
    "termdock"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:termdock.terminal"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The view is available, but shell processes can only start in trusted workspaces.",
      "restrictedConfigurations": [
        "termdock.shell",
        "termdock.shellArgs",
        "termdock.cwd"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "A real filesystem and shell are required."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "termdock",
          "title": "Termdock",
          "icon": "media/terminal.svg"
        }
      ]
    },
    "views": {
      "termdock": [
        {
          "type": "webview",
          "id": "termdock.terminal",
          "name": "Termdock",
          "icon": "media/terminal.svg",
          "contextualTitle": "Termdock"
        }
      ]
    },
    "commands": [
      {
        "command": "termdock.focus",
        "title": "Termdock: Focus"
      },
      {
        "command": "termdock.new",
        "title": "Termdock: New Terminal",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted && termdock.canCreate"
      },
      {
        "command": "termdock.clear",
        "title": "Termdock: Clear Display",
        "icon": "$(clear-all)",
        "enablement": "termdock.hasSessions"
      },
      {
        "command": "termdock.restart",
        "title": "Termdock: Restart Terminal",
        "icon": "$(refresh)",
        "enablement": "termdock.hasSessions"
      },
      {
        "command": "termdock.kill",
        "title": "Termdock: Close Terminal",
        "icon": "$(trash)",
        "enablement": "termdock.hasSessions"
      },
      {
        "command": "termdock.switch",
        "title": "Termdock: Switch Terminal",
        "icon": "$(list-selection)",
        "enablement": "termdock.hasSessions"
      },
      {
        "command": "termdock.copy",
        "title": "Termdock: Copy Selection",
        "enablement": "termdock.hasSessions"
      },
      {
        "command": "termdock.paste",
        "title": "Termdock: Paste",
        "enablement": "termdock.activeRunning"
      },
      {
        "command": "termdock.settings",
        "title": "Termdock: Settings"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "termdock.switch",
          "when": "view == termdock.terminal",
          "group": "navigation@1"
        },
        {
          "command": "termdock.new",
          "when": "view == termdock.terminal",
          "group": "navigation@2"
        },
        {
          "command": "termdock.kill",
          "when": "view == termdock.terminal",
          "group": "navigation@3"
        },
        {
          "command": "termdock.clear",
          "when": "view == termdock.terminal",
          "group": "1_terminal@1"
        },
        {
          "command": "termdock.restart",
          "when": "view == termdock.terminal",
          "group": "1_terminal@2"
        },
        {
          "command": "termdock.copy",
          "when": "view == termdock.terminal",
          "group": "2_clipboard@1"
        },
        {
          "command": "termdock.paste",
          "when": "view == termdock.terminal",
          "group": "2_clipboard@2"
        },
        {
          "command": "termdock.settings",
          "when": "view == termdock.terminal",
          "group": "3_settings@1"
        }
      ]
    },
    "configuration": {
      "title": "Termdock",
      "properties": {
        "termdock.shell": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Shell executable. Empty uses $SHELL on macOS/Linux, or PowerShell on Windows. In Remote SSH this is a path on the remote host."
        },
        "termdock.shellArgs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "scope": "machine-overridable",
          "description": "Shell arguments. Null uses -l on macOS and no arguments elsewhere. An empty array disables default arguments."
        },
        "termdock.cwd": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Starting directory. Empty uses the active workspace folder, then the first folder, then your home directory. Supports ${workspaceFolder} and ${userHome}."
        },
        "termdock.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Terminal font. Empty inherits the integrated terminal/editor font."
        },
        "termdock.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "Font size. 0 inherits the integrated terminal font size."
        },
        "termdock.scrollback": {
          "type": "integer",
          "default": 2000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Scrollback lines per terminal. Changes apply to new terminals."
        },
        "termdock.cursorBlink": {
          "type": "boolean",
          "default": true,
          "description": "Blink the terminal cursor."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/ui.cjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:ui",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --skip-license --out termdock-0.3.0.vsix"
  },
  "dependencies": {
    "@xterm/xterm": "5.5.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.106.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.0"
  },
  "author": "yevin",
  "repository": {
    "type": "git",
    "url": "https://github.com/YevinDong/termdock.git"
  },
  "icon": "media/icon.png"
}
